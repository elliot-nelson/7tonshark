---
import Base from "../layouts/Base.astro";
import { getSortedPosts, postSlug } from "../lib/posts";

const posts = await getSortedPosts();
const latest = posts.slice(0, 10);

const fmt = (d: Date) =>
	d.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
---

<Base>
	<h1>7 ton shark</h1>
	<p>The personal website of <a href="/about/">Elliot Nelson</a>.</p>

	<h2>Latest Posts</h2>
	<ul class="postlist">
		{
			latest.map((post) => (
				<li>
					<a href={`/posts/${postSlug(post)}/`}>{post.data.title}</a>
					<time datetime={post.data.date.toISOString().slice(0, 10)}>
						{fmt(post.data.date)}
					</time>
				</li>
			))
		}
	</ul>

	{
		posts.length > latest.length && (
			<p>
				<a href="/posts/">
					{posts.length - latest.length} more posts in the archive →
				</a>
			</p>
		)
	}
</Base>
